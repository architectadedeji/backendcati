# StreamCATI Backend Configuration

# Database Configuration
# Development (default): SQLite - no external service required
# Production (MySQL): DATABASE_URL=mysql+aiomysql://username:password@hostname:3306/streamcati
DATABASE_URL=sqlite+aiosqlite:///./db.sqlite3

# Auth
SECRET_KEY=streamcati-backend-secret-key-2026-development
TOKEN_EXPIRY_HOURS=24

# CORS
CORS_ORIGINS=https://streamcati-frontend.vercel.app, http://localhost:5173,http://127.0.0.1:5173

# App
ENVIRONMENT=development
TESTING_MODE=true
TESTING_INTERVAL_MINUTES=1
PRODUCTION_INTERVAL_MONTHS=3
