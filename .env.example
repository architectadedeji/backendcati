# StreamCATI Backend Configuration - Example
# Copy this file to .env and customize for your environment

# ======================
# DATABASE CONFIGURATION
# ======================
# Development (SQLite - recommended for local development):
# DATABASE_URL=sqlite+aiosqlite:///./db.sqlite3

# Production (MySQL - recommended for production):
# DATABASE_URL=mysql+aiomysql://username:password@hostname:3306/database_name
DATABASE_URL=sqlite+aiosqlite:///./db.sqlite3

# ======================
# AUTHENTICATION
# ======================
# Use a strong secret key in production (min 32 characters)
SECRET_KEY=your-secure-secret-key-change-in-production
TOKEN_EXPIRY_HOURS=24

# ======================
# CORS CONFIGURATION
# ======================
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ======================
# APPLICATION SETTINGS
# ======================
ENVIRONMENT=development
TESTING_MODE=true
TESTING_INTERVAL_MINUTES=2
PRODUCTION_INTERVAL_MONTHS=3

# ======================
# PRODUCTION EXAMPLES
# ======================
# For production MySQL deployment:
# ENVIRONMENT=production
# SECRET_KEY=your-very-secure-production-key-64bytes-minimum
# DATABASE_URL=mysql+aiomysql://prod_user:prod_password@prod-db.example.com:3306/streamcati_prod
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# TESTING_MODE=false
