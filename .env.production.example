# StreamCATI Backend Configuration
# Environment: Production (MySQL)
# ================================

# To use this configuration, copy values to your .env file or set as environment variables

# Database: MySQL Configuration
# Format: mysql+aiomysql://username:password@hostname:port/database_name
DATABASE_URL=mysql+aiomysql://root:your_password@prod-db-host.com:3306/streamcati

# Authentication - Use a strong, random key for production
SECRET_KEY=your-very-secure-production-secret-key-minimum-32-characters-long

# Token expiry in hours
TOKEN_EXPIRY_HOURS=24

# CORS - allowed frontend origins (comma-separated)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Application Environment
ENVIRONMENT=production
TESTING_MODE=false
TESTING_INTERVAL_MINUTES=60
PRODUCTION_INTERVAL_MONTHS=3
